{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-inspection.local/schemas/visual-symbol-eval.schema.json",
  "title": "Sealed current-source visual symbol evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha256",
    "annotation_owner_role",
    "annotation_status",
    "pages"
  ],
  "properties": {
    "schema_version": {
      "const": "visual-symbol-eval/1"
    },
    "source_sha256": {
      "const": "58b9cf08ad90ad4ef647661165e989cd45984dbeaa9c0f63042a69eccc017bec"
    },
    "annotation_owner_role": {
      "const": "quality_owner"
    },
    "annotation_status": {
      "const": "approved"
    },
    "pages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sealedInputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest",
        "components"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "latencyDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "durations_ms"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "durations_ms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "p50_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_ms": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "p50_ms"
                ]
              },
              {
                "required": [
                  "p95_ms"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "p50_ms",
              "p95_ms"
            ],
            "properties": {
              "sample_count": {
                "minimum": 20
              },
              "durations_ms": {
                "minItems": 20
              }
            }
          }
        }
      ]
    },
    "routingComparisonEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sealed_input_identity",
        "outputs",
        "recall_delta",
        "quality_owner_verdict_refs"
      ],
      "properties": {
        "schema_version": {
          "const": "symbol-routing-comparison/1"
        },
        "sealed_input_identity": {
          "$ref": "#/$defs/sealedInputIdentity"
        },
        "outputs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/routingComparisonOutput"
          }
        },
        "recall_delta": {
          "$ref": "#/$defs/routingComparisonRecallDelta"
        },
        "quality_owner_verdict_refs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacy_high_recall",
            "production_uncertainty"
          ],
          "properties": {
            "legacy_high_recall": {
              "$ref": "#/$defs/qualityOwnerVerdictRefs"
            },
            "production_uncertainty": {
              "$ref": "#/$defs/qualityOwnerVerdictRefs"
            }
          }
        }
      }
    },
    "routingComparisonOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "cache_state",
        "run_identity",
        "sealed_input_identity_sha256",
        "content_identity_sha256",
        "counts",
        "reason_distribution",
        "latency_distribution",
        "completeness_outcomes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "legacy_high_recall",
            "production_uncertainty"
          ]
        },
        "cache_state": {
          "enum": [
            "cold",
            "warm"
          ]
        },
        "run_identity": {
          "type": "string",
          "minLength": 1
        },
        "sealed_input_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "counts": {
          "$ref": "#/$defs/routingComparisonCounts"
        },
        "reason_distribution": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "latency_distribution": {
          "$ref": "#/$defs/latencyDistribution"
        },
        "completeness_outcomes": {
          "$ref": "#/$defs/routingComparisonOutcomes"
        }
      }
    },
    "routingComparisonCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted",
        "local",
        "escalated",
        "deduped",
        "cache_hits",
        "calls",
        "unresolved"
      ],
      "properties": {
        "admitted": { "type": "integer", "minimum": 0 },
        "local": { "type": "integer", "minimum": 0 },
        "escalated": { "type": "integer", "minimum": 0 },
        "deduped": { "type": "integer", "minimum": 0 },
        "cache_hits": { "type": "integer", "minimum": 0 },
        "calls": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 }
      }
    },
    "routingComparisonOutcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "partial_review_required",
        "blocked"
      ],
      "properties": {
        "complete": { "type": "integer", "minimum": 0 },
        "partial_review_required": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 }
      }
    },
    "routingComparisonRecallDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_positive_recall",
        "uncertainty_positive_recall",
        "delta",
        "legacy_negative_candidate_count",
        "uncertainty_negative_candidate_count"
      ],
      "properties": {
        "legacy_positive_recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "uncertainty_positive_recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "delta": { "type": "number" },
        "legacy_negative_candidate_count": { "type": "integer", "minimum": 0 },
        "uncertainty_negative_candidate_count": { "type": "integer", "minimum": 0 }
      }
    },
    "qualityOwnerVerdictRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_index",
        "labels"
      ],
      "properties": {
        "page_index": {
          "type": "integer",
          "minimum": 0
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/label"
          }
        }
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_id",
        "bbox_pdf",
        "symbol_kinds",
        "expected_disposition",
        "expected_projection"
      ],
      "properties": {
        "label_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "bbox_pdf": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        },
        "symbol_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "diameter",
              "depth",
              "counterbore",
              "surface_roughness",
              "gdt_parallelism",
              "gdt_perpendicularity",
              "gdt_flatness",
              "datum_reference",
              "revision_marker",
              "frozen_negative"
            ]
          }
        },
        "negative_family": {
          "enum": [
            "part_or_hole_geometry",
            "hatch_center_or_cross",
            "dimension_leader_or_section_line",
            "view_or_section_label",
            "revision_table_or_invalid_marker",
            "datum_like_letter_or_table_cell",
            "watermark_logo_title_or_signoff",
            "isometric_hole_slot_or_edge",
            "ordinary_text_number_material_or_requirement"
          ]
        },
        "expected_disposition": {
          "enum": [
            "candidate",
            "reference_context",
            "non_inspection",
            "ambiguous"
          ]
        },
        "expected_projection": {
          "oneOf": [
            {
              "enum": [
                "diameter_dimension",
                "thread",
                "composite",
                "roughness",
                "geometric_tolerance"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "diameter"
                  ]
                },
                "expected_disposition": {
                  "const": "candidate"
                },
                "expected_projection": {
                  "const": "diameter_dimension"
                }
              },
              "not": {
                "required": [
                  "negative_family"
                ]
              }
            },
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "depth"
                  ]
                },
                "expected_disposition": {
                  "const": "candidate"
                },
                "expected_projection": {
                  "enum": [
                    "diameter_dimension",
                    "thread",
                    "composite"
                  ]
                }
              },
              "not": {
                "required": [
                  "negative_family"
                ]
              }
            },
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "diameter",
                    "depth"
                  ]
                },
                "expected_disposition": {
                  "const": "candidate"
                },
                "expected_projection": {
                  "enum": [
                    "diameter_dimension",
                    "thread",
                    "composite"
                  ]
                }
              },
              "not": {
                "required": [
                  "negative_family"
                ]
              }
            },
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "diameter",
                    "depth",
                    "counterbore"
                  ]
                },
                "expected_disposition": {
                  "const": "candidate"
                },
                "expected_projection": {
                  "const": "composite"
                }
              },
              "not": {
                "required": [
                  "negative_family"
                ]
              }
            },
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "surface_roughness"
                  ]
                },
                "expected_disposition": {
                  "const": "candidate"
                },
                "expected_projection": {
                  "const": "roughness"
                }
              },
              "not": {
                "required": [
                  "negative_family"
                ]
              }
            },
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "gdt_parallelism"
                  ]
                },
                "expected_disposition": {
                  "const": "candidate"
                },
                "expected_projection": {
                  "const": "geometric_tolerance"
                }
              },
              "not": {
                "required": [
                  "negative_family"
                ]
              }
            },
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "gdt_perpendicularity"
                  ]
                },
                "expected_disposition": {
                  "const": "candidate"
                },
                "expected_projection": {
                  "const": "geometric_tolerance"
                }
              },
              "not": {
                "required": [
                  "negative_family"
                ]
              }
            },
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "gdt_flatness"
                  ]
                },
                "expected_disposition": {
                  "const": "candidate"
                },
                "expected_projection": {
                  "const": "geometric_tolerance"
                }
              },
              "not": {
                "required": [
                  "negative_family"
                ]
              }
            },
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "datum_reference"
                  ]
                },
                "expected_disposition": {
                  "const": "reference_context"
                },
                "expected_projection": {
                  "type": "null"
                }
              },
              "not": {
                "required": [
                  "negative_family"
                ]
              }
            },
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "revision_marker"
                  ]
                },
                "expected_disposition": {
                  "const": "non_inspection"
                },
                "expected_projection": {
                  "type": "null"
                }
              },
              "not": {
                "required": [
                  "negative_family"
                ]
              }
            },
            {
              "properties": {
                "symbol_kinds": {
                  "const": [
                    "frozen_negative"
                  ]
                },
                "expected_disposition": {
                  "enum": [
                    "non_inspection",
                    "ambiguous"
                  ]
                },
                "expected_projection": {
                  "type": "null"
                }
              },
              "required": [
                "negative_family"
              ]
            }
          ]
        }
      ]
    }
  }
}
