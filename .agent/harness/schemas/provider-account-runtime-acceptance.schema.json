{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-inspection.local/schemas/provider-account-runtime-acceptance.schema.json",
  "title": "Immutable provider account runtime acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cycle_id", "run_id", "project_id", "readiness_sha256", "submission_started_sha256", "settlement_sha256", "call_evidence_sha256", "model", "ledger_attempt_index", "accepted_at", "content_sha256"],
  "properties": {
    "schema_version": {"const": "provider-account-runtime-acceptance/1"},
    "cycle_id": {"const": "gdt10e-auth-remediated-live-20260802"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{12}Z-[0-9a-f]{8}$"},
    "project_id": {"type": "string", "minLength": 1},
    "readiness_sha256": {"$ref": "#/$defs/sha256"},
    "submission_started_sha256": {"$ref": "#/$defs/sha256"},
    "settlement_sha256": {"$ref": "#/$defs/sha256"},
    "call_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "model": {"const": "qwen3-vl-plus-2025-12-19"},
    "ledger_attempt_index": {"type": "integer", "minimum": 1},
    "accepted_at": {"type": "string", "minLength": 1},
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
