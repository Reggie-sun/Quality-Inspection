{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-inspection.local/schemas/contract-result.schema.json",
  "title": "One P0 contract execution result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "p0_contract_id",
    "command",
    "exit_code",
    "result_state",
    "started_at",
    "completed_at",
    "artifact_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "contract-result/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{12}Z-[0-9a-f]{8}$"
    },
    "p0_contract_id": {
      "type": "string",
      "pattern": "^P0-[A-Z]+-[0-9]{3}[A-Z]?$"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "exit_code": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_state": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "uniqueItems": true
    }
  }
}
