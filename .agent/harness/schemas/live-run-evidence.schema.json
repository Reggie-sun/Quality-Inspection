        "consistency"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 4 },
        "opaque_ref": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "project_url": {
          "type": "string",
          "pattern": "^/\\?project_id=.+&operator_id=.+$"
        },
        "process": {
          "oneOf": [
