            { "type": "null" }
          ]
        },
        "review": {
          "oneOf": [
            { "$ref": "#/$defs/review_evidence" },
            { "type": "null" }
          ]
        },
        "human_verdict": {
          "oneOf": [
            { "$ref": "#/$defs/human_verdict" },
            { "type": "null" }
          ]
        },
        "balloons": {
          "oneOf": [
            { "$ref": "#/$defs/balloon_evidence" },
            { "type": "null" }
          ]
        },
        "export": {
          "oneOf": [
            { "$ref": "#/$defs/export_evidence" },
            { "type": "null" }
          ]
        },
        "consistency": {
