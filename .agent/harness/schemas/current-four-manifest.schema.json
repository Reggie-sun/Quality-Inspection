  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "basename",
        "sha256",
        "opaque_ref",
        "page_metadata"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "basename": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.pdf$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "opaque_ref": {
          "type": "string",
          "pattern": "^external-input://sha256/[0-9a-f]{64}$",
          "description": "Opaque identity only; host source paths are forbidden."
        },
        "page_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "page_count",
            "physical_page"
          ],
          "properties": {
            "page_count": {
              "type": "integer",
              "minimum": 1
            },
            "physical_page": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
