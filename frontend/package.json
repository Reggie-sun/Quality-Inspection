{
  "name": "quality-inspection-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest --dir src",
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
    "api:generate": "openapi-typescript ../backend/tests/contract/snapshots/api-v1.openapi.json -o src/api/generated.ts",
    "api:check": "openapi-typescript ../backend/tests/contract/snapshots/api-v1.openapi.json | diff -u src/api/generated.ts -"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "6.7.6",
    "typescript": "^5.8.3",
    "vite": "^6.1.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "undici": "6.28.0"
  }
}
